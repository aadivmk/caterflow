# CaterFlow environment variables
# Copy this file to .env.local and fill in the values.
#
# Leave NEXT_PUBLIC_DATA_MODE empty to run in local mode: data is stored in the
# browser's localStorage and no account is needed.
#
# Set it to "mongodb" to store everything in MongoDB and require sign-in.
NEXT_PUBLIC_DATA_MODE=

# --- MongoDB mode only. These are SERVER-ONLY secrets: never prefix them with
# NEXT_PUBLIC_ and never commit .env.local.
# Local server:  mongodb://127.0.0.1:27017
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=
MONGODB_DB=caterflow
# Any random string of 16+ characters; used to sign sign-in tokens.
JWT_SECRET=
